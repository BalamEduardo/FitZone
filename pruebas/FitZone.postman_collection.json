    {
      "name": "06 · Inscripción exitosa",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/inscripciones",
        "description": "Se espera HTTP 201.",
        "body": {
          "mode": "raw",
          "raw": "{\"idSocio\": {{idSocioValido}}, \"idClase\": {{idClaseRegistro}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const d = pm.response.json();",
              "pm.test(\"Inscripción creada\", () => { pm.expect(d.idInscripcion).to.be.a(\"number\"); pm.expect(String(d.idSocio)).to.eql(pm.collectionVariables.get(\"idSocioValido\")); pm.expect(String(d.idClase)).to.eql(pm.collectionVariables.get(\"idClaseRegistro\")); });",
              "pm.collectionVariables.set(\"idInscripcionCreada\", String(d.idInscripcion));"
            ]
          }
        }
      ],
      "response": []
    },
