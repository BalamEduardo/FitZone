{
  "info": {
    "name": "FitZone - Reto 1 | Pruebas de API",
    "_postman_id": "fab31573-2d73-40ca-91c5-a85c47f9bf83",
    "description": "Colección con aserciones automáticas. Antes de ejecutar: correr fitzone_datos_prueba.sql y llenar las variables con los IDs obtenidos. Ejecutar UNA vez en el orden establecido. El código Java no se modifica. Las confirmaciones/recordatorios se verifican en la consola.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 · Estado de la API",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/estado",
        "description": "Se espera HTTP 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const d = pm.response.json();",
              "pm.test(\"Aplicación FitZone funcionando\", () => { pm.expect(d.aplicacion).to.eql(\"FitZone\"); pm.expect(d.estado).to.eql(\"Funcionando\"); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 · Listar clases",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/clases",
        "description": "Se espera HTTP 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const d = pm.response.json();",
              "pm.test(\"Lista JSON de clases\", () => { pm.expect(d).to.be.an(\"array\"); pm.expect(d.length).to.be.greaterThan(0); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "03 · Consultar cupo libre",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/clases/{{idClaseRegistro}}/cupo",
        "description": "Se espera HTTP 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const d = pm.response.json();",
              "pm.test(\"Cupo inicial de 20\", () => { pm.expect(d.capacidadMaxima).to.eql(20); pm.expect(d.inscritos).to.eql(0); pm.expect(d.lugaresDisponibles).to.eql(20); pm.expect(d.hayCupo).to.eql(true); });"
            ]
          }
        }
      ],
      "response": []
    },
